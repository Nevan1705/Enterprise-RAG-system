# Primary LLM Engine Settings (Groq Cloud LPU)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Distributed Task Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Secondary LLM Fallback Engine (LlamaIndex wrapper)
LLAMAINDEX_MODEL=openai/gpt-oss-120b
# LLAMAINDEX_API_KEY=your_secondary_api_key_here

# LLM Hyperparameters & Timeouts
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_TIMEOUT=30

# Chunking & Semantic Retrieval Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
